@baseURL = http://localhost:3000
@token_novo = 
@token_admin = 

### Cadastro de novo usuário
POST {{baseURL}}/auth/register
Content-Type: application/json 

{
"name": "Usuario 2",
"email": "usuario2@example.com",
"phone_number": "1111111111",
"password": "usuario2"
}


### Login do novo usuário (pegar o token gerado e colar na variavel token_novo)
POST {{baseURL}}/auth/login
Content-Type: application/json

{
"email": "usuario2@example.com",
"password": "usuario2"
}

### Login do admin
POST {{baseURL}}/auth/login
Content-Type: application/json

{
  "email": "admin@agenda.com",
  "password": "senha_admin"
}

### Tentativa de login com senha incorreta - esperado: 401
POST {{baseURL}}/auth/login
Content-Type: application/json

{
"email": "novo_usuario@example.com",
"password": "senha_errada"
}


### Acesso sem token - esperado: 401 se a rota estiver protegida
GET {{baseURL}}/events
Accept: application/json


### Acesso com token valido - esperado: 200 se usuario comum puder listar eventos
GET {{baseURL}}/events
Accept: application/json
Authorization: Bearer {{token_novo}}


### Criar evento com usuario comum - esperado: 403 se apenas admin puder criar
POST {{baseURL}}/events
Content-Type: application/json
Authorization: Bearer {{token_novo}}

{
  "user_id": 1,
  "space_id": 1,
  "customer_id": 1,
  "event_name": "Evento Usuario Comum",
  "event_description": "Teste de autorizacao",
  "event_date": "02/07/26",
  "event_start": "02/07/26 10:00:00",
  "seats_count": 20,
  "setup_type": "buffet",
  "event_status": "nao_confirmado"
}


### Criar evento - esperado: 201 se o usuario logado puder criar eventos
POST {{baseURL}}/events
Content-Type: application/json
Authorization: Bearer {{token_admin}}

{
  "user_id": 1,
  "space_id": 1,
  "customer_id": 1,
  "event_name": "Evento Admin",
  "event_description": "Criado por admin",
  "event_date": "02/07/26",
  "event_start": "02/07/26 10:00:00",
  "seats_count": 50,
  "setup_type": "buffet",
  "event_status": "confirmado"
}

